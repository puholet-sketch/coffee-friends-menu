{
  "classicDurationSec": 22,
  "cfDurationSec": 5.25,
  "eyebrowClassic": "Осень",
  "eyebrowCf": "CoffeeFriends",
  "classic": [
    {
      "id": "pushkin-unylaya",
      "lines": [
        "Унылая пора! очей очарованье!",
        "Приятна мне твоя прощальная краса —",
        "Люблю я пышное природы увяданье,",
        "В багрец и в золото одетые леса,",
        "В их сенях ветра шум и свежее дыханье,",
        "И мглой волнистою покрыты небеса,",
        "И редкий солнца луч, и первые морозы,",
        "И отдаленные седой зимы угрозы."
      ],
      "author": "А. С. Пушкин"
    },
    {
      "id": "tyutchev-est-v-oseni",
      "lines": [
        "Есть в осени первоначальной",
        "Короткая, но дивная пора —",
        "Весь день стоит как бы хрустальный,",
        "И лучезарны вечера…"
      ],
      "author": "Ф. И. Тютчев"
    },
    {
      "id": "tyutchev-serp",
      "lines": [
        "Где бодрый серп гулял и падал колос,",
        "Теперь уж пусто всё — простор везде, —",
        "Лишь паутины тонкий волос",
        "Блестит на праздной борозде."
      ],
      "author": "Ф. И. Тютчев"
    },
    {
      "id": "bunin-terem",
      "lines": [
        "Лес, точно терем расписной,",
        "Лиловый, золотой, багряный,",
        "Весёлой, пёстрою стеной",
        "Стоит над светлою поляной.",
        "Берёзы жёлтою резьбой",
        "Блестят в лазури голубой.",
        "Как вышки, ёлочки темнеют,",
        "А между клёнами синеют…"
      ],
      "author": "И. А. Бунин"
    },
    {
      "id": "esenin-nivy",
      "lines": [
        "Нивы сжаты, рощи голы,",
        "От воды туман и сырость.",
        "Колесом за сини горы",
        "Солнце тихое скатилось.",
        "Дремлет взрытая дорога.",
        "Ей сегодня примечталось,",
        "Что совсем-совсем немного",
        "Ждать зимы седой осталось."
      ],
      "author": "С. А. Есенин"
    },
    {
      "id": "pleshcheev-osen",
      "lines": [
        "Осень наступила,",
        "Высохли цветы,",
        "И стоят безмолвны",
        "Голые кусты.",
        "Вянет и желтеет",
        "Травка на лугах,",
        "Только зеленеет",
        "Озимь на полях."
      ],
      "author": "А. Н. Плещеев"
    },
    {
      "id": "pushkin-nebo",
      "lines": [
        "Уж небо осенью дышало,",
        "Уж реже солнышко блистало,",
        "Короче становился день,",
        "Лесов таинственная сень",
        "С печальным шумом обнажалась,",
        "Ложился на поля туман,",
        "Гусей крикливых караван",
        "Тянулся к югу: приближалась…"
      ],
      "author": "А. С. Пушкин"
    },
    {
      "id": "fet-sad",
      "lines": [
        "Осень. Обсыпается весь наш бедный сад,",
        "Листья пожелтелые по ветру летят;",
        "Лишь вдали красуются, там, на дне долин,",
        "Кисти ярко-красные вянущих рябин."
      ],
      "author": "А. А. Фет"
    },
    {
      "id": "nekrasov-grachi",
      "lines": [
        "Поздняя осень. Грачи улетели,",
        "Лес обнажился, поля опустели,",
        "Только не сжата полоска одна…",
        "Грустную думу наводит она.",
        "Кажется, шепчут колосья друг другу:",
        "«Скучно нам слушать осеннюю вьюгу,",
        "Скучно склоняться до самой земли,",
        "Тучные зерна купая в пыли!»"
      ],
      "author": "Н. А. Некрасов"
    },
    {
      "id": "pushkin-oktyabr",
      "lines": [
        "Октябрь уж наступил — уж роща отряхает",
        "Последние листы с нагих своих ветвей;",
        "Дохнул осенний хлад — дорога промерзает.",
        "Журча ещё бежит за мельницу ручей,",
        "Но пруд уже застыл; сосед мой поспешает",
        "В отъезжие поля с охотою своей,",
        "И страждут озими от бешеной забавы,",
        "И будит лай собак уснувшие дубравы."
      ],
      "author": "А. С. Пушкин"
    }
  ],
  "coffeeFriends": [
    {
      "id": "cf-listya",
      "lines": [
        "Кружатся листья —",
        "медь и охра.",
        "В стакане пар —",
        "и осень хороша."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-oktyabr-steklo",
      "lines": [
        "Октябрь стучит в стекло",
        "жёлтым пальцем.",
        "Мы отвечаем",
        "латте и тишиной."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-kombo",
      "lines": [
        "Снаружи — ветер и шинель.",
        "Внутри — корица и тепло.",
        "Бери комбо:",
        "осень любит пары."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-list-tochka",
      "lines": [
        "Лист упал —",
        "как точка в книге дня.",
        "Страницу греем",
        "чашкой чая."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-zoloto",
      "lines": [
        "Золото во дворе,",
        "золото в пенке.",
        "Осень платит",
        "добрым кофе."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-kitezh",
      "lines": [
        "Туман на Китеже,",
        "свет в окне.",
        "Два этажа уюта —",
        "заходи ко мне."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-dozhd",
      "lines": [
        "Дождь рисует",
        "полосы на стекле.",
        "Мы рисуем",
        "улыбки в капучино."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-raf",
      "lines": [
        "Короткий день —",
        "длинный раф.",
        "Пусть вечер",
        "будет мягче."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-sharf",
      "lines": [
        "Снимите осень",
        "с плеч, как шарф.",
        "Оставьте её",
        "на дне чашки."
      ],
      "author": "CoffeeFriends"
    },
    {
      "id": "cf-greet",
      "lines": [
        "Листья уходят —",
        "гости приходят.",
        "CoffeeFriends",
        "греет осень."
      ],
      "author": "CoffeeFriends"
    }
  ]
}
